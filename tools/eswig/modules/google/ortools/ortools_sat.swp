// -------------- -Constraint- ---------------
//
%esb_wrap_as_ref(operations_research::sat::Constraint,				"7F2491A6-3E62-4D95-8694-2544564449AF", "Constraint",     				"ќграничение",     ""); 
//
%ignore operations_research::sat::Constraint::WithName;
//NOTE	Ќаш (≈—Ѕ) Constraint называетс€ также как и operations_research::sat::Constraint. 
//		Ёто нормально дл€ с++ т.к. эти классы будут в разных namespace.
//		Ќќ! —виг об этом не знает и разворачивает Constraint до пространства имен куда метод вставл€етс€.
//		“о есть до operations_research::sat:: ј там свой Constraint.
//		»спользование префикса this:: у Constraint преп€тствует разворачиванию —вигом до operations_research::sat::Constraint
//		а сам этот префикс мы в коде вырезаем дл€ %extend-методов. Ёто у нас хак такой.. (см.код модул€.)
//
//TODO	¬се варианты ..Constraint унаследованы от просто Constraint, а поскольку метод WithName у просто Constraint возвращает просто Constraint
//		“ќ! ¬ наследниках мы тер€ем конкретный тип. «агадка зачем √угль так сделал. 
//		(» вообще больша€ загадка зачем это все сделано именно так поскольку внутри этот WithName возвращает *this, а не новый объект)
//		¬идимо в этой клетке такие правила...
//		Ќќ! ” нас затык - сделать "перекрытие" расширеного метода из базового расширенным методом в наследнике не получаетс€ :(
//		ѕолучаетс€ два метода WithName.. “о ли у мен€ проблема, то ли у —виг, хз.. “ребует изучени€.
//		
//		» при этом получаетс€, что нам метод WithName_ возвращающий значение вообще один на всех наследников делать нельз€
//		так как это в с++ operations_research::sat::Constraint легко и непринужденно преобразуетс€ к operations_research::sat::CircuitConstraint
//		и наоборот. ј у нас в ≈—Ѕ это два разных типа с разными гуидами ничего друг о друге не знающие. Ќет у нас в ≈—Ѕ пон€ти€ наследовани€ пока..
//
//TODO	 ј–ƒ»ЌјЋ№Ќќ≈ решение этой проблемы сделать в инвоукере есб конвертацию "на лету" в std::string
//		ј все эти WithName врапить как return this
//
//		ј пока.. ƒелаем процедуру SetName одну на всех ничего не возвращающую. 
//		ј там где эти "Constraint" создают по возможности попытаемс€ создавать их сразу с именем если нужно дл€ удобства
// 
//%extend operations_research::sat::Constraint {
//	this::Constraint WithName_(const String& name_)
//	{
//		return convert_to_ret<Constraint>( this->GetThisOwnerHandler(), _.WithName(convert_to_arg<std::string>(name_)) );
//	}
//}
//
%extend operations_research::sat::Constraint {
	void SetName(const String& name_)
	{
		//NOTE используем конвертацию в std::string, хот€ WithName декларирован от string_view
		//		это сделано специально чтобы не объ€вл€ть конвертатор в string_view, 
		//		который может быть небезопасным в иных контекстах
		_.WithName(convert_to_arg<std::string>(name_));
	}
}
//
//NOTE	Ёто все наследники Constraint и получают _as_ref автоматически
//TODO	на случай €вного указани€ _val/_ref дл€ класса-наследника нужно в коде сделать проверку конфликта с базовым
//
