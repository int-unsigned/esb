// ------------- -absl::Span- ----------------------------------------
// 
//NOTE	ћногие методы —ј“ принимают в качестве параметра absl::Span<-чего-то->
//		Ќо мы не делаем эти Span отдельными 1—-объектами, т.к. фактически јѕ» декларировано
//		таким образом дл€ удобства - Span может на лету создаватьс€ из любого подход€щего контейнера
//		(например из вектора)
//		(а нам еще и очень неудобно делать объект-Span т.к. это рефтип требующий владельца) 
//		ѕоэтому мы делаем объекты-векторы необходимых типов, 
//		а дл€ соответствующийх Span указываем, что они _well_known_ со спец-конвертером
//		(см. esb_map_well_known_for_arg_template)
//
%esb_wrap_as_template(	std::vector<operations_research::sat::IntVar>,	"(IntegerVariable, IntegerVariableRef, IntegerVariableConst, IntegerVariableCRef)",	
						"59853312-892B-4260-AE43-180627102E42", 	CppArrayOfIntegerVariable, 		"—ппћассивѕерем÷елое", 					"");
