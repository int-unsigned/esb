%rename(WeightedSumOfBooleanVariables)			operations_research::sat::LinearExpr::WeightedSum(absl::Span<const BoolVar> vars, absl::Span<const int64_t> coeffs);
%esb_name_local("¬звешенна€—умма÷елых")			operations_research::sat::LinearExpr::WeightedSum(absl::Span<const operations_research::sat::IntVar>, absl::Span<const int64_t>);
%esb_name_local("¬звешенна€—уммаЅулевых")		operations_research::sat::LinearExpr::WeightedSum(absl::Span<const operations_research::sat::BoolVar>, absl::Span<const int64_t>);
%esb_name_local("¬звешенна€—умма")				operations_research::sat::LinearExpr::WeightedSumOf;
//
%extend operations_research::sat::LinearExpr
{
static IntegerLinearExpr WeightedSumOf(OneOf< CppArrayOfIntegerVariable, CppArrayOfBooleanVariable > const & vars_, CppArrayOfInteger64 const & coeffs_)
{
	if (vars_.is<CppArrayOfIntegerVariable>())
		return WeightedSumOfIntegerVariables(vars_.as<CppArrayOfIntegerVariable>(), coeffs_);
	return WeightedSumOfBooleanVariables(vars_.make<CppArrayOfBooleanVariable>(), coeffs_);
}
}


//NOTE	„е такое "“ерм" - не знаю.
//		написано: "Constructs var * coefficient"
//static LinearExpr Term(IntVar var, int64_t coefficient);
//static LinearExpr Term(BoolVar var, int64_t coefficient);
//
%rename(TermOfIntegerVariable)			operations_research::sat::LinearExpr::Term(IntVar, int64_t);
%rename(TermOfBooleanVariable)			operations_research::sat::LinearExpr::Term(BoolVar, int64_t);
%esb_name_local("“ерм»зѕерем÷елое")     operations_research::sat::LinearExpr::Term(operations_research::sat::IntVar var, int64_t coefficient);
%esb_name_local("“ерм»зѕеремЅулево")    operations_research::sat::LinearExpr::Term(operations_research::sat::BoolVar var, int64_t coefficient);
%esb_name_local("“ерм»з")     			operations_research::sat::LinearExpr::TermOf;
//
%extend operations_research::sat::LinearExpr 
{
static IntegerLinearExpr TermOf(OneOf< IntegerVariable, BooleanVariable > const & variable_, Numeric const & coeffs_)
{
	if (variable_.is<IntegerVariable>())
		return TermOfIntegerVariable(variable_.as<IntegerVariable>(), coeffs_);
	return TermOfBooleanVariable(variable_.make<BooleanVariable>(), coeffs_);
}
}




