%esb_wrap_info_cref(	std::vector<double>,		"3827901F-7A37-4747-8D9E-F3DDD4845A0E", 	"CppArrayOfDoubleCRef",	"—ппћассивƒействительных онст—сылка",		"");
%esb_wrap_as_template(	std::vector<double>,	"(Double, DoubleRef, DoubleConst, DoubleCRef)",	
						"07E27711-4CF9-4B24-A384-60810EADB49E", 	CppArrayOfDouble, 				"—ппћассивƒействительных", 					"");
