						"59853312-892B-4260-AE43-180627102E42", 	CppArrayOfBooleanVariable, 		"—ппћассивѕеремЅулево", 					"");
%esb_ctor_creator(std::vector<operations_research::sat::BoolVar>::vector());
%esb_map_well_known_for_arg_template(absl::Span<::operations_research::sat::BoolVar const>, 
	"const CppArrayOfBooleanVariable&", "convert_to_arg<const std::vector<operations_research::sat::BoolVar>&>",	AbslSpanOfConstBooleanVariable );
//
