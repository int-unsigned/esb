%esb_wrap_info_cref(operations_research::sat::LinearExpr,		"9B374D9E-F77D-4E35-A4F1-F670C6F01014", "IntegerLinearExprCRef",	"Ћинейное¬ыраж÷елочисленное онст—сылка",	"");
%esb_wrap_info_ref(	operations_research::sat::LinearExpr,		"599A204D-1380-4059-9BB9-994DF6854986", "IntegerLinearExprRef",		"Ћинейное¬ыраж÷елочисленное—сылка",			"");
//NOTE	_cval вариант дл€ использовани€ в контейнере
%esb_wrap_info_cval(operations_research::sat::LinearExpr,		"3C70ED53-4E73-4F38-965F-4EFB2387B89D", "IntegerLinearExprConst",	"Ћинейное¬ыраж÷елочисленное онст",			"");
//NOTE	Ёто деклараци€ дополнительного объекта "статический-интерфейс-дл€-.."
//		” LinearExpr есть статические методы, которые можно вызывать без создани€ экземпл€ра класса
//		чтобы не делать некрасивые LinearExpr_DoFoo(), мы создаем отдельный класс только со статическим методами из LinearExpr
//		и возвращаем его экземпл€р свойством компоненты LinearExpr
//		“о есть из 1— статические методы LinearExpr можно будет вызывать как <компонента>.LinearExpr.DoFoo()
//		(практически как в c#)
//		ѕ—. экземпл€р класса "статический-интерфейс-дл€-.." создаетс€ статическим один раз при первом вызове.
//			накладные расходы "на красоту" минимальны
%esb_wrap_info_stat(operations_research::sat::LinearExpr,		"BBB822EC-FB42-4248-B146-1326A0E9DB51", "IntegerLinearExprStat",	"Ћинейное¬ыраж÷елочисленное—татик",			"");
// собственно LinearExpr
%esb_wrap_as_val(	operations_research::sat::LinearExpr,  		"D1961343-644B-431C-8495-ABF365DA7AF8", "IntegerLinearExpr",		"Ћинейное¬ыраж÷елочисленное",				"");


//NOTE	¬ ор-тулс есть свободные операторы +/- дл€ создани€ нового выражени€ с добавкой(вычитанием)
//		Ќо мне показалось что свободные операторы использовать семантически не красиво
//		поэтому расшир€ю интерфейс самого выражени€ (дл€ красоты)
%esb_name_local("—оздатьЌовоеƒобавив")			operations_research::sat::LinearExpr::CreateNewWithAdd;
%esb_name_local("—оздатьЌовоеќтн€в")			operations_research::sat::LinearExpr::CreateNewWithSub;
//
%extend operations_research::sat::LinearExpr {
	IntegerLinearExpr CreateNewWithAdd(const Numeric& value_) const
	{
		return convert_to_ret<IntegerLinearExpr>(_ + convert_to<int64_t>(value_));
	}
	IntegerLinearExpr CreateNewWithSub(const Numeric& value_) const
	{
		return convert_to_ret<IntegerLinearExpr>(_ - convert_to<int64_t>(value_));
	}
}


