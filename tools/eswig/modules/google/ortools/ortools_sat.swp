//NOTE	_ref и _cval варианты дл€ использовани€ в контейнере
%esb_wrap_info_ref(	operations_research::sat::BoolVar,  		"F4DE7E27-9F88-445F-A58C-44A66002704E", "BooleanVariableRef", 		"ѕеремЅулево—сылка",			"ќбъект ѕеремЅулево—сылка");
%esb_wrap_info_cval(operations_research::sat::BoolVar,  		"5C027AFB-3FFB-49E4-874C-B035143D4697", "BooleanVariableConst",		"ѕеремЅулево онст",				"ќбъект ѕеремЅулево онст");
//
%esb_wrap_as_ref(	operations_research::sat::BoolVar, 			"59853312-892B-4260-AE43-180627102E42", "BooleanVariable", 			"ѕеремЅулево", 					"«начение —атЅулево");
//NOTE	»нтересна€ "фишка" —виг (или мой баг). Ќам надо просто заменить реализацию WithName своей
//		≈сли мы просто игнорим WithName и сразу же %extend WithName, то никакого WithName в классе нет - игнорировалс€.
//		Ќќ! ≈сли сделать %extend WithName_ (с _ в конце), то %extend метод по€вл€етс€ с именем Ѕ≈« _ - т.е. просто WithName
//		“о что нам и надо!
//
%ignore operations_research::sat::BoolVar::WithName;
//NOTE	Ќаш вставл€емый метод AsLinearExpr зависит от враппера IntegerLinearExpr (создает его как возвращаемое значение), 
//		который будет емититьс€ позже. ѕереставл€ть не получитс€, т.к. он тоже зависит от нас.
//		ѕоэтому просто положим имплементацию в самом конце модул€, где все определени€ вже гарантировано сделаны.
//
%esb_implementation_place_at_end(operations_research::sat::BoolVar::AsLinearExpr() const);
//
%extend operations_research::sat::BoolVar {
	BooleanVariable WithName_(const String& name_)
	{
		return convert_to_ret<BooleanVariable>( this->GetThisOwnerHandler(), _.WithName(convert_to_arg<std::string>(name_)) );
	}
//TODO	¬ с++ класс LinearExpr имеет открытые конструкторы от BoolVar, IntVar, и int64_t
//		—оответственно где LinearExpr используетс€ как аргумент происходит "тиха€ конвертаци€" и создание LinearExpr из соответствующих объектов
//		ј используетс€ LinearExpr оч.много где. ¬идимо поэтому √угль и решил сделать так - дл€ удобства себ€ и юзеров.
//		Ќам бы по хорошему "дл€ удобства юзеров" тоже нужно везде где используетс€ LinearExpr сделать аргументы OneOf<LinearExpr, BoolVar, IntVar, int64_t> 
//		и тихо выбирать вариант переданный юзером.
//		Ќќ! ƒл€ нас это реальный гимор т.к. какого-то "авто" создани€ такого јѕ» нет.
//		ѕќЁ“ќћ”! ѕока дл€ объектов BoolVar и IntVar сделаем €вные методы преобразовани€ - пусть юзер маетс€, а не мы. ѕотом посмотрим..
//TODO	ѕ—. ≈ще нужно ‘рии метод сделать "—оздатьЋинейное¬ыражение»з„исла" дл€ int64_t
//
	IntegerLinearExpr AsLinearExpr() const 
	{
		return  IntegerLinearExpr::Create(_);
	}
}
%esb_name_local("»нвертированное")				operations_research::sat::BoolVar::operator ~() const;




