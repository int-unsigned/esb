// -------------- -CpModelBuilder- ---------------
//
%esb_wrap_as_val(operations_research::sat::CpModelBuilder,     "99F0EF35-53F7-48F1-875B-99D94C017D44", "OptimizationModelBuilder",			"ѕостроительќптимизационнойћодели",	"");
%esb_ctor_creator(operations_research::sat::CpModelBuilder::CpModelBuilder());
//
%extend operations_research::sat::CpModelBuilder {
	BooleanVariable CreateBooleanVariableWithName(ESB_THIS_ENTITY_HANDLER_, const String& name_)
	{
		return convert_to_ret<BooleanVariable>(ESB_MOVE_ENTITY_HANDLER_, _.NewBoolVar().WithName(convert_to_arg<std::string>(name_)));
	}
	IntegerVariable CreateIntegerVariableWithName(ESB_THIS_ENTITY_HANDLER_, const DomainOfInteger64& domain_, const String& name_)
	{
		return convert_to_ret<IntegerVariable>(ESB_MOVE_ENTITY_HANDLER_, _.NewIntVar(convert_to_arg<const operations_research::Domain&>(domain_)).WithName(convert_to_arg<std::string>(name_)));
	}
	this::Constraint AddAllDifferentIntegerVariables(ESB_THIS_ENTITY_HANDLER_, const OneOf<CppArrayOfIntegerVariable, Array>& variables_)
	{
		if(auto may_be_variables_vector = variables_.make_if<CppArrayOfIntegerVariable>())
			return convert_to_ret<Constraint>(ESB_MOVE_ENTITY_HANDLER_, _.AddAllDifferent(convert_to_arg<const std::vector<::operations_research::sat::IntVar>&>(*may_be_variables_vector)) );
		else       
			return convert_to_ret<Constraint>(ESB_MOVE_ENTITY_HANDLER_, _.AddAllDifferent(convert_to_arg_vector<::operations_research::sat::IntVar, IntegerVariable>(variables_.make<Array>()) ) );
	}
	this::Constraint AddAllDifferentLinearExpressions(ESB_THIS_ENTITY_HANDLER_, const Array& expr_array_)
	{
		return convert_to_ret<Constraint>(ESB_MOVE_ENTITY_HANDLER_, _.AddAllDifferent(convert_to_arg_vector<::operations_research::sat::LinearExpr, IntegerLinearExpr>(expr_array_)));
	}
}

