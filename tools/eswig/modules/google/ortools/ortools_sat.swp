//NOTE	»гнорирование Not (см.ниже) делаем ƒќ %include "ortools/sat/cp_model.h", чтобы "игнор" применилс€
//
%ignore operations_research::sat::Not(BoolVar);
//
%include "ortools/sat/cp_model.h"
//
// 
//BoolVar Not(BoolVar x);
//TODO	BoolVar - это реф-тип, и дл€ создани€ нового-инвертированного в методе нужен ему владелец
//		по смыслу вроде пон€тно, что новому-инвертированному как-то нужно дать того же владельца, что и у аргумента
//		Ќќ! ≈—виг так глубоко не мыслит.
//		ѕоэтому оргинальный метод игнорируем и всовываем свой, который просто вызывает .Not у аргумента
//		(собственно как и гугль в коде делает)
//NOTE	¬ключение делаем ѕќ—Ћ≈ %include "ortools/sat/cp_model.h", чтобы ѕќ—Ћ≈ определени€ BooleanVariable было
//
%esb_inline 
%{
inline
BooleanVariable NotBooleanVariable(const BooleanVariable& value_)
{
	return value_.GetContained().Not();
}
%}
//TODO	Ќахально всовываем %esb_inline в интерфейс модул€
//NOTE	»менуем »нвертировать, хот€ у Ѕулево есть и метод »нвертировать, но он вызывает тот же .Not
//		(иное разумное ру-им€ дл€ NotBooleanVariable, но не "»нвертировать" придумать немогу... ЌеѕеремЅулево? ќтрицнутьѕеремЅулево? хз..)
%add_to_module_interface_meth(NotBooleanVariable, "»нвертироватьѕеремЅулево")

