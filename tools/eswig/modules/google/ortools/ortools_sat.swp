%esb_wrap_info(operations_research::sat::TableConstraint,			"5D705B08-C7EB-4EF3-AE24-244AA0010FF5", "TableConstraint",				"“абличноеќграничение",				"");    
%esb_wrap_info(operations_research::sat::ReservoirConstraint,		"30975558-71B2-4760-B234-2E0BCBA81B2D", "ReservoirConstraint",			"–езервуарќграничений",				"");    
%esb_wrap_info(operations_research::sat::AutomatonConstraint,		"52D0C6BD-95DE-4C93-8036-6E74CD9C2CA0", "AutomatonConstraint",			"ќграничениејвтомат",				"");    
%esb_wrap_info(operations_research::sat::NoOverlap2DConstraint,		"EEBDB193-5193-489D-AEA2-5A429CE1283C", "NoOverlap2DConstraint",		"ќграничениеЅезѕерекрыти€2D",		"");    
%esb_wrap_info(operations_research::sat::CumulativeConstraint,		"034A5744-608D-4017-99BA-EDFF0C6F1BCF", "CumulativeConstraint",			"Ќакопительноеќграничение",			"");    
