{
	class CpSolverResponse 
	{
		public:
//NOTE  .wall_time() возвращает double. ” Numeric есть конструктор от double, хот€, видимо, double представл€етс€ в Numeric с ограничени€ми.
//      ƒумаю что в этом контексте это не важно и не будем делать свой Double-Wrapper. »ли будем.. хз..
		double wall_time() const;
	};
}
