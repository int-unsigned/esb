%rename(CpSolverResponseStatsWhenHasObjective)			operations_research::sat::CpSolverResponseStats(operations_research::sat::CpSolverResponse const &);
%esb_name_local("СтатистикаРешенияПриДостиженииЦели")	operations_research::sat::CpSolverResponseStats(operations_research::sat::CpSolverResponse const &);
%esb_name_local("СтатистикаРешения")					operations_research::sat::CpSolverResponseStats(operations_research::sat::CpSolverResponse const &, bool);
//TODO	Вот тут интересная ситуация. Два перегруженных метода здесь сделал Свиг из /bool has_objective = true/
//		и один из них мы ручками переименовали в ...WhenHasObjective ЧТО КСТАТИ можно попробовать делать алгоритмически в модуле
//		но тогда получается, что наш алгоритм ЗРЯ и некрасиво переименовывает оставшуюся перегрузку
//		в CpSolverResponseStatsResponseHasObjective
//		НУЖНО а) доработать алгоритм обработки перегрузок, чтобы если переименованы все методы-перегрузки кроме одного 
//				(вне зависимости от букетов по кол-ву параметров), то последний оставшийся метод не переименовывать.
//			  б) научиться автоматом разруливать этот вариант возникновения перегруженных методов,
//				скажем также - путем добавления суффикса ..WhenHasObjective для bool has_objective = true
//				или в общем ..WhenParamValue для type param_ = value_, н.р. для count_=5 будет ..WhenCount5
//				(у Свиг есть какой-то аттрибут defaultvalue)
// А пока просто переименовываем CpSolverResponseStats в CpSolverResponseStats чтобы алгоритм метод не трогал.
%rename(CpSolverResponseStats)							operations_research::sat::CpSolverResponseStats(operations_research::sat::CpSolverResponse const &, bool);



