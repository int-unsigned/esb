//CpSolverResponse SolveWithParameters(const CpModelProto& model_proto, const SatParameters& params);
//CpSolverResponse SolveWithParameters(operations_research::sat::CpModelProto const &,std::string const &);
//NOTE	Эти два перегруженных метода "разводим" по имени.
//		Причем что основной для САТ (от SatParameters) оставляем с тем же именем, 
//		а к тому что из std::string-JSON добавляем суффикс JSON.
//		И для них не нужно делать универсальный SolveWithParameters от OneOf<SatParameters, String>
//		так как из того что методу передается String никак не следует, что String должен быть в JSON-формате
//		Это ошибка семантики Гугля. Пусть лучше метод принимающий JSON будет с суффиксом JSON
//
%esb_name_local("РешиЗадачуСПараметрами")				operations_research::sat::SolveWithParameters(operations_research::sat::CpModelProto const &,operations_research::sat::SatParameters const &);
//TODO	Чтобы Swig(ESwig) "почуял" что имя метода все таки должено быть "как доктор прописал", его приходится переименовать в то же само имя...
//		(а без переименования делает SolveWithParametersModelProto)
//		странный эффект.. нужно разобраться
%rename(SolveWithParameters)							operations_research::sat::SolveWithParameters(operations_research::sat::CpModelProto const &,operations_research::sat::SatParameters const &);
//
//TODO	мы делаем здесь convert_to_arg<std::string const &>(params_) - то есть к ссылке (как у аргумента std::string const &)
//		НО! Преобразование String -> std::string для _arg_ допустимо, но все же не к ссылке! или к std::string const && уж тогда, хз..
//		
%esb_name_local("РешиЗадачуСПараметрамиJSon")			operations_research::sat::SolveWithParameters(operations_research::sat::CpModelProto const &,std::string const &);
%rename(SolveWithParametersJSon)						operations_research::sat::SolveWithParameters(operations_research::sat::CpModelProto const &,std::string const &);



//	CpSolverResponse SolveCpModel(const CpModelProto& model_proto, Model* model);
//	void LoadAndSolveCpModelForTest(const CpModelProto& model_proto, Model* model);
//
// По какой-то причине эти два метода имеют парамером УКАЗАТЕЛЬ на Модель
// хотя в реализации этот указатель используется безо всякой проверки на НУЛЛ !
// т.е. фактически должна быть ССЫЛКА на Модель
// В таком виде их враппить для скриптового языка просто НЕЛЬЗЯ.
// Поэтому ИГНОРИРУЕМ и вручную делаем враппер
//
//TODO	"Ручной" враппер получился практически-автоматическим. Нужно Свиг рассказать..
//%esb_name_local("РешиЗадачуПоМодели")		operations_research::sat::SolveCpModel(operations_research::sat::CpModelProto const &, operations_research::sat::Model *);
//
%ignore		operations_research::sat::SolveCpModel(CpModelProto const &, Model *);
//
%esb_inline 
%{
inline
SolverResponse SolveModel(const OptimizationModelProto& model_proto_, SatModel model_)
{
	return 
	convert_to_ret<SolverResponse>
	(
		operations_research::sat::SolveCpModel(convert_to_arg<const operations_research::sat::CpModelProto&>(model_proto_), convert_to_arg<operations_research::sat::Model*>(model_))
	);
}
%}
//TODO	Нахально всовываем %esb_inline в интерфейс модуля
%add_to_module_interface_meth(SolveModel, "РешиЗадачуПоМодели")


