%esb_ortools_proto_prop(operations_research::sat::SatParameters, enumerate_all_solutions, "EnumerateAllSolutions", "ѕеречислить¬се–ешени€");
%esb_ortools_proto_prop(operations_research::sat::SatParameters, keep_all_feasible_solutions_in_presolve, "KeepAllFeasibleSolutionsInPresolve", "—охран€ть¬се¬озможные–ешени€¬ѕредварительном–ежиме");

%esb_ortools_proto_list(operations_research::sat::SatParameters, extra_subsolvers, 
