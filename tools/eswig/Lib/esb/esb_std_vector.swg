///////////
// std::vector


// Для указания типа произведенного из шаблона (template<...>) нужно дать Свиг определение шаблона
// (именно определение, а не только объявление. можно дать пустое)
//TODO	к сожалению он этот тип тоже емитит, а нам бы желательно чтобы using SatArrayOfInteger64 = ArrayOf<SatInteger64>
//TODO	даем определение шаблона с одним параметром, хотя их три.
//		но если сделать все три с значениями по-умолчанию, то Свиг как-то путается.. разобраться!


//NOTE	Весь шаблон нельзя объявлять _well_known_ типом, т.к. _well_known_ типом он может стать только при специализации _well_known_ типом
//		По смыслу _well_known_-типы не емитятся, а только регистрируются и подразумевается, что esb о них как-то само знает
//		Пример - int, или std::string
//		А для того чтобы емитить ESB_WRAPPER_FOR_STL_VECTOR(...) нужно чтобы был враппер. он для шаблона просто емитится специфически.
//TODO	К слову об std::string - ЕСвиг-а еще нужно научить подключать в инклюдах "esb/esb_stl_string_a.h", если встречается std::string
//
//%esb_well_known_type(std::vector);


//NOTE	Нам необходимо пометить тип-контейнер, что он контейнер неких элементов
//		Так как обычно в с++ из контейнера всегда возвращается ссылка на содержащийся элемент
//		шаблон контейнера в esb сразу инициализируется с типами содержашегося значения и соответствующих ссылок
//		и нам надо проверить чтобы соответствующие типы-ссылки были определены
//		т.е. если используется std::vector<::operations_research::ClosedInterval>, 
//		то для ClosedInterval должны быть определены и SatClosedInterval и SatClosedIntervalRef и SatClosedIntervalCRef и SatClosedIntervalConst
//		ПС. SatClosedIntervalCRef нужен поскольку const std::vector<..> должен возвращать конст-ссылку 
//			(а это практически всегда требуется, поскольку аргументы методов обычно декларируются как конст - const std::vector<..>&)
//			А SatClosedIntervalConst тоже лучше чтобы был, поскольку вероятно преобразование const std::vector<ClosedInterval>& в ::span<const ClosedInterval>
//			Короче лучше все иметь и сразу..
//
%esb_container(std::vector);

namespace std {
	template<class _Tp>
  	class vector{};
}


