///////////
// std::string_view

%esb_wrap_as_ref(std::string_view, 		"D96F801E-1A1E-4E4B-82BC-E1F8467C63F0", "CppStringViewAnsi", 	"СппСтрокаВьюАнси",		"");
%esb_well_known_type(std::string_view);
%esb_converter_for_arg(std::string_view, "convert_to<std::string>");
//
namespace std 
{
	class string_view{};
}


//NOTE	Мы здесь объявляем конвертер через convert_to<std::string> для всех вариантов ::string_view, и для && тоже. 
//		Это представляется безопасным поскольку этот конвертер будет использоваться исключительно для передачи параметров в контексте вызова метода 
//		(т.е. в контексте вычисления полного выражения), т.е. временная string гарантировано будет жить до конца всего вызова.
//
//NOTE	Объявление typemap по сути никак не связано с собственно объявлением/определением класса std::string_view в esb_std_string_view_a.swg
//		Подсистема typemap у Свиг это отдельная от дерева классов подсистема опирающаяся на строки и паттерн-матчинг
//		Это объявление typemap можно делать в любом месте где требуется, а также средствами Свиг отменять, переопределять и т.п.
//
//TODO	Если будет typemap, но не будет самого объявления класса, то "удивлен" будет только наш ЕСвиг, который проверяет целостность системы типов.
//
//TODO	Нужно сделать чтобы "проверка типов" в том числе и проверяла наличие тип-мап для неизвестного типа, и, в случае наличия тип-мап делала просто Warning-что-тип-мап-есть-а-типа-нет, 
//		а в случае отсутствия и тип-мап уже делала Error т.к. если нет тип-мап не понятно каким типом объявлять параметры для метода враппера и каким типом объявлять выозвращаемое значение.
//		(в случае отсутствия тип-мап вообще Свиг вроде делает void* или SWIGTYPE, короче ерунду)
//		Лучше при этом указывать эмиттеру генерить из имени типа с++ просто добавляя какой-то префикс/суффикс вроде 
//		string_view -> EsbCorrspondingType<string_view> в рассчете что в Esb есть такие специализации (псевдонимы), 
//		или ESB_CORRESPONDING_TYPE(string_view) в рассчете что в Есб есть такие макросы
//		Макросы наверное лучше.. Гибче. Никто не мешает макрос развернуть в псевдоним, но в варианте с макросом возможна еще пред-обработка просто токена.
//		(допускаю, что этот сценарий где-то окажется полезным)
//
//TODO	Не исключено что вообще нужно предусмотреть опцию "все-умное-отключить" и генерить все только макросами.
//		Только нужно два макроса ESB_CORRESPONDING_TYPE_RET(string_view) для возвращаемых типов и ESB_CORRESPONDING_TYPE_ARG(string_view) для параметров.
//
//NOTE	Аттрибут converter_for_arg="convert_to<std::string>" указывает ЕСвиг не использовать стандартную конвертацию в тип параметра оборачивамого метода 
//		а вызывать непосредственно что написано.
//		То есть для string_view БЕЗ этого аттрибута было бы convert_to<std::string_view>(..), чего по-умолчанию в есб нет т.к. небезопасно
//		а испоьзовать convert_to<std::string>(..) что в есб есть, а параметр объявленный как string_view из std::string&& сам создастся
//		и в контексте вызова метода это будет безопасно.
//		ПС. аттрибуту converter_for_arg=.. можно любое писать - главное чтобы с++ потом это "любое" нашел. то есть это "пользовательская" конвертация.
//
%define %esb_1C_typemap_for_std_string_view_a()
	%typemap(ctype, ret="String", converter_for_arg="convert_to_arg<std::string>") 	std::string_view, std::string_view&, std::string_view&&, const std::string_view, const std::string_view&, const std::string_view&&	"const String&"
%enddef
