Функция СтартТест() Экспорт
	сообщить("*----------------------------------------------------------------------");
		привет = ЭтотКомпонент().GetHellow();
		ЭтотКомпонент().СкажиПривет( привет );
	сообщить("*----------------------------------------------------------------------");
		ответ = Вопрос(привет + Символы.ПС + Символы.ПС + "Завершить тест???", РежимДиалогаВопрос.ОКОтмена);
		Если Ответ = КодВозвратаДиалога.ОК Тогда
			ЗавершитьРаботуСистемы(Ложь)
		КонецЕсли;
	возврат Истина;
КонецФункции


