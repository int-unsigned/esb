  <!--    Настройки для отладчика сохраняются в .vcxproj.user файл, но мастер шаблонов студии не копирует .vcxproj.user файл 
	.vcxproj.user файл подключается в 
	Microsoft.Common.targets импортирует...
		...\Microsoft Visual Studio\...\MSBuild\Current\Bin\Microsoft.Common.CurrentVersion.targets и там...
			...<Import Project="$(MSBuildProjectFullPath).user" Condition="Exists('$(MSBuildProjectFullPath).user')"/>
	То есть подключается когда подключаются все .targets в самом-самом конце
	То есть все свойства прописанные в .vcxproj.user нам не доступны 
	(вернее доступны только для Item т.к. они оцениваются на втором проходе)
	Поэтому настройки специфичные именно для проекта 
	(не есб, а проекта - в частности откуда запускать 1С для отладки) мы пишем в сам файл проекта
		TODO    Мы вынуждены этот блок делать ДО импорта Microsoft.Cpp.Default.props, который импортирует наш directory.build.props
		        в котором настройки для нашего отладчика
		        возможно более правильно в directory.build.props только отпределять $(ForceImportAfterCppDefaultProps),
				который импортируется в конце Microsoft.Cpp.Default.props
				или(и) через $(ForceImportBeforeCppProps) или $(ForceImportAfterCppProps)
				которые импортируются соответственно в самом начале и в самом конце Microsoft.Cpp.props
				когда уже определены настройки в разрезе конфигураций
	-->
  <PropertyGroup Label="EsbSettingsRun" Condition="'$(Configuration)|$(Platform)'=='v8309Debug|Win32'">
    <ESB_1C_PATH>C:\Program Files\1cv8\8.3.9.1818\bin</ESB_1C_PATH>
  </PropertyGroup>
  <PropertyGroup Label="EsbSettingsRun" Condition="'$(Configuration)|$(Platform)'=='v8309Release|Win32'">
    <ESB_1C_PATH>C:\Program Files\1cv8\8.3.9.1818\bin</ESB_1C_PATH>
  </PropertyGroup>

  	<!-- Опции где Есб и какая версия должны быть определены ДО включения directory.build.props
			Поэтому мы храним их в .vcxproj файле и ДО включения Microsoft.Cpp.Default.props
	ПС. Несмотря на то, что в группе с меткой EsbSettingsVer совсем нет свойства ESB_VER
		Студия чует что оно там должно быть и показывает на странице свойств пустым 
		(у страницы свойств указано что оно там должно быть)
		(если и пустую группу удалить, то покажет по-умолчанию ESB_VER_AUTO как в .props указано)
		(Ну ооочень умная, ммм.., программа..)
 	-->
  <PropertyGroup Label="EsbSettingsCfg">
    <ESB_PATH>$(ESB_PATH_AUTO)</ESB_PATH>
  </PropertyGroup>
  <PropertyGroup Label="EsbSettingsVer">
  </PropertyGroup>

  <!-- Microsoft.Cpp.Default.props импортирует наше directory.build.props и мы начнем что-то знать о есб -->
