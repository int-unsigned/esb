<?xml version="1.0" encoding="utf-8"?>
<VSTemplate Version="3.0.0" Type="Project" xmlns="http://schemas.microsoft.com/developer/vstemplate/2005" xmlns:sdk="http://schemas.microsoft.com/developer/vstemplate-sdkextension/2010">
  <TemplateData>
    <Name>EsbStudio C++ component for 1C(tm)</Name>
    <Description>Шаблон C++ Есб-Компоненты для 1С</Description>
    <Icon>esb_proj_template.jpg</Icon>
    <ProjectType>VC</ProjectType>
    <LanguageTag>cpp</LanguageTag>
	<LanguageTag>1C Enterprise</LanguageTag>
	<PlatformTag>windows</PlatformTag>
	<ProjectTypeTag>desktop</ProjectTypeTag>
    <SortOrder>1000</SortOrder>
    <TemplateID>41d73f2d-df50-468a-85a0-90461f994a40</TemplateID>
	<!-- При отсутствии этого тега, поле для выбора .NET-Framework в мастере не показывается
		<RequiredFrameworkVersion>2.0</RequiredFrameworkVersion> -->
    <CreateNewFolder>true</CreateNewFolder>
    <DefaultName>EsbComponent</DefaultName>
    <ProvideDefaultName>true</ProvideDefaultName>
  </TemplateData>
  <TemplateContent>
		<CustomParameters>
			<!-- <CustomParameter Name="$FOO$" Value="Red"/> -->
		</CustomParameters>
	  <Project TargetFileName="esb_template.vcxproj" File="esb_template.vcxproj" ReplaceParameters="true">
	  </Project>
  </TemplateContent>
	<WizardExtension>
		<Assembly>EsbStudio, Version=1.0.0.0, Culture=Neutral, PublicKeyToken=5af9f167dd3f4af2</Assembly>
		<FullClassName>EsbStudio.EsbProjectTemplateWizardImplementation</FullClassName>
	</WizardExtension>
	<!-- 	XML to pass to the custom wizard extension as $wizarddata$ in replacements_dictionary_ 
			!! полностью текстом вместе с комментариями, таб и переносами строк !!
			используем для передаче списка доп.файлов которые надо скопировать
			символ \ в начале означает не копирование файла, а создание папки
			если файл копируется в папку, то сначала нужно указать создание папки
			(выполняется в RunStarted, когда в папке назначения НИЧЕГО еще нет)
	-->
	<WizardData>\1s;_1s_create.cmd;_esb_1s_property_page_schema.xml;_1s_run.cmd;directory.build.props;directory.build.targets;_esb_props_ui.xml;esb_studio_readme.txt;\1s_files;1s_files\Configuration.xml;\1s_files\Languages;1s_files\Languages\Русский.xml;\1s_files\CommonModules;1s_files\CommonModules\EsbCommon.xml;1s_files\CommonModules\EsbComponent.xml;1s_files\CommonModules\EsbManager.xml</WizardData>	
</VSTemplate>