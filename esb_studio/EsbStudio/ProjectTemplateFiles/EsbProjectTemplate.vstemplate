<?xml version="1.0" encoding="utf-8"?>
<VSTemplate Version="3.0.0" Type="Project" xmlns="http://schemas.microsoft.com/developer/vstemplate/2005" xmlns:sdk="http://schemas.microsoft.com/developer/vstemplate-sdkextension/2010">
  <TemplateData>
    <Name>EsbStudio C++ component for 1C(tm)</Name>
    <Description>Шаблон C++ Есб-Компоненты для 1С</Description>
    <Icon>esb_proj_template.jpg</Icon>
    <ProjectType>VC</ProjectType>
    <LanguageTag>cpp</LanguageTag>
	<LanguageTag>1C Enterprise</LanguageTag>
	<PlatformTag>windows</PlatformTag>
	<ProjectTypeTag>desktop</ProjectTypeTag>
    <SortOrder>1000</SortOrder>
    <TemplateID>41d73f2d-df50-468a-85a0-90461f994a40</TemplateID>
	<!-- При отсутствии этого тега, поле для выбора .NET-Framework в мастере не показывается
		<RequiredFrameworkVersion>2.0</RequiredFrameworkVersion> -->
    <CreateNewFolder>true</CreateNewFolder>
    <DefaultName>EsbComponent</DefaultName>
    <ProvideDefaultName>true</ProvideDefaultName>
  </TemplateData>
  <TemplateContent>
		<CustomParameters>
			<!-- <CustomParameter Name="$FOO$" Value="Red"/> -->
		</CustomParameters>
	  <Project TargetFileName="esb_template.vcxproj" File="esb_template.vcxproj" ReplaceParameters="true">
<ProjectItem ReplaceParameters="true" TargetFileName="directory.build.props">directory.build.props</ProjectItem>
<ProjectItem ReplaceParameters="true" TargetFileName="directory.build.targets">directory.build.targets</ProjectItem>
<ProjectItem ReplaceParameters="true" TargetFileName="dllmain.cpp">dllmain.cpp</ProjectItem>
<ProjectItem ReplaceParameters="true" TargetFileName="esb.h">esb.h</ProjectItem>
<ProjectItem ReplaceParameters="true" TargetFileName="esbmain.cpp">esbmain.cpp</ProjectItem>
<ProjectItem ReplaceParameters="true" TargetFileName="esb_app_config.h">esb_app_config.h</ProjectItem>
<ProjectItem ReplaceParameters="true" TargetFileName="esb_studio_readme.txt">esb_studio_readme.txt</ProjectItem>
<ProjectItem ReplaceParameters="true" TargetFileName="$safeprojectname$.vcxproj">esb_template.vcxproj</ProjectItem>
<ProjectItem ReplaceParameters="true" TargetFileName="$safeprojectname$.vcxproj.filters">esb_template.vcxproj.filters</ProjectItem>
<ProjectItem ReplaceParameters="true" TargetFileName="_esb_1s_property_page_schema.xml">_esb_1s_property_page_schema.xml</ProjectItem>
<ProjectItem ReplaceParameters="true" TargetFileName="_esb_props_ui.xml">_esb_props_ui.xml</ProjectItem>
<Folder Name="1s">
</Folder>
<Folder Name="1s_files">
<ProjectItem ReplaceParameters="true" TargetFileName="Configuration.xml">Configuration.xml</ProjectItem>
<Folder Name="CommonModules">
<ProjectItem ReplaceParameters="true" TargetFileName="EsbCommon.xml">EsbCommon.xml</ProjectItem>
<ProjectItem ReplaceParameters="true" TargetFileName="EsbComponent.xml">EsbComponent.xml</ProjectItem>
<ProjectItem ReplaceParameters="true" TargetFileName="EsbManager.xml">EsbManager.xml</ProjectItem>
<Folder Name="EsbCommon">
<Folder Name="Ext">
<ProjectItem ReplaceParameters="true" TargetFileName="Module.bsl">Module.bsl</ProjectItem>
</Folder>
</Folder>
<Folder Name="EsbComponent">
<Folder Name="Ext">
<ProjectItem ReplaceParameters="true" TargetFileName="Module.bsl">Module.bsl</ProjectItem>
</Folder>
</Folder>
<Folder Name="EsbManager">
<Folder Name="Ext">
<ProjectItem ReplaceParameters="true" TargetFileName="Module.bsl">Module.bsl</ProjectItem>
</Folder>
</Folder>
</Folder>
<Folder Name="Ext">
<ProjectItem ReplaceParameters="true" TargetFileName="OrdinaryApplicationModule.bsl">OrdinaryApplicationModule.bsl</ProjectItem>
</Folder>
<Folder Name="Languages">
<ProjectItem ReplaceParameters="true" TargetFileName="Русский.xml">Русский.xml</ProjectItem>
</Folder>
</Folder>
	  </Project>
  </TemplateContent>
	<WizardExtension>
		<Assembly>EsbStudio, Version=1.0.0.0, Culture=Neutral, PublicKeyToken=5af9f167dd3f4af2</Assembly>
		<FullClassName>EsbStudio.EsbProjectTemplateWizardImplementation</FullClassName>
	</WizardExtension>
	<!-- 	XML to pass to the custom wizard extension as $wizarddata$ in replacements_dictionary_ 
			!! полностью текстом вместе с комментариями, таб и переносами строк !!
			используем для передаче списка доп.файлов которые надо скопировать
			символ \ в начале означает не копирование файла, а создание папки
			если файл копируется в папку, то сначала нужно указать создание папки
			(выполняется в RunStarted, когда в папке назначения НИЧЕГО еще нет)
	-->
	<WizardData>\1s;_1s_create.cmd;_esb_1s_property_page_schema.xml;_1s_run.cmd;directory.build.props;directory.build.targets;_esb_props_ui.xml;esb_studio_readme.txt;\1s_files;1s_files\Configuration.xml;\1s_files\Languages;1s_files\Languages\Русский.xml;\1s_files\CommonModules;1s_files\CommonModules\EsbCommon.xml;1s_files\CommonModules\EsbComponent.xml;1s_files\CommonModules\EsbManager.xml</WizardData>	
</VSTemplate>
