Функция ИмяФайлаКомпоненты() Экспорт
	Возврат "nqueens.dll";
КонецФункции
Функция ИмяОбъектаКомпоненты() Экспорт
	Возврат "ЕсбРешательПроблем";
КонецФункции
//
Функция Загрузить(путь_к_файлу_компоненты_) Экспорт
	файл_компоненты = ПутьДостроить(путь_к_файлу_компоненты_, ИмяФайлаКомпоненты());
	возврат EsbManager.ЗагрузитьЕсбКомпоненту(файл_компоненты, ИмяОбъектаКомпоненты(), __EsbComponent__, __EsbComponentObject__);
КонецФункции
//
Процедура Выгрузить() Экспорт	
	EsbManager.ВыгрузитьЕсбКомпоненту(__EsbComponent__, __EsbComponentObject__);
КонецПроцедуры
//
Функция ЭтотКомпонент() экспорт
	возврат __EsbComponentObject__;
КонецФункции 
///////////////////////////////////////////////////////////////////////////////////////

Процедура НаблюдательЗаРешением(структура_модели_, результ_) Экспорт
	сообщить("* НаблюдательЗаРешением ----------------------------------------------->");

	сообщить("ИндексРешения: " + структура_модели_.КоличествоРешений);

	Для индекс_строки = 0 по структура_модели_.РазмерДоски - 1 Цикл
		строка_решения = "";
		Для индекс_столбца = 0 по структура_модели_.РазмерДоски - 1 Цикл
			Если результ_.ЗначениеПеремЦелое(структура_модели_.Ферзи[индекс_столбца]) = индекс_строки Тогда						
				строка_решения = строка_решения + "Ф";
			Иначе
				строка_решения = строка_решения + "_";
			КонецЕсли;
			Если индекс_столбца <> структура_модели_.РазмерДоски - 1 Тогда
				строка_решения = строка_решения + " ";
			КонецЕсли;
		КонецЦикла;
		сообщить(строка_решения);
	КонецЦикла;

	структура_модели_.КоличествоРешений = структура_модели_.КоличествоРешений + 1;

	сообщить("*----------------------------------------------------------------------");	
КонецПроцедуры 


Процедура РешиФерзей(размер_доски_)
	Остап				= ЭтотКомпонент();
	построитель_модели	= Остап.СоздатьПостроительОптимизационнойМодели();
	домен_переменных	= Остап.СоздатьДоменЦелых64НаИнтервале(0, размер_доски_ - 1);


	// В этом варианте "ферзи" это 1С-массив, который заполняют esb-объектами
	//	(можно добавить что угодно и все сломается на .ДобавитьВсеРазличныеПеремЦелое(ферзи))
	//ферзи				= Новый Массив(размер_доски_);
	//Для индекс = 0 по размер_доски_ - 1 Цикл
	//	ферзи[индекс] = построитель_модели.СоздатьПеремЦелоеСИменем(домен_переменных, "х" + индекс);
	//КонецЦикла;
	
	// В этом варианте "ферзи" это esb-массив (с++ вектор)
	//	(что угодно не добавишь - сломается сразу)
	//
	ферзи				= Остап.СоздатьСппМассивПеремЦелое();
	//
	//NOTE	В c++ нельзя создать массив элементов IntegerVariable сразу заданного размера
	//		(можно создать вектор заданного размера заполненного значениями по-умолчанию)
	//		НО!	для элементов типа IntegerVariable этого сделать нельзя, т.к. IntegerVariable - это "reference-тип" 
	//		- по сути он содержит ссылку на свои данные, которые лежат в ПостроительМодели
	//		т.е. у IntegerVariable обязательно должен быть владелец и "пустой" IntegerVariable 
	//			-- это "Doing so will crash.." (из документации OrTools) --
	//		Поэтому наша компонента НЕ ДАЕТ возможности создавать "пустые" IntegerVariable
	// Поэтому мы здесь создаем пустой массив и отдельно устанавливаем ему емкость (для эффективности)
	//
	ферзи.УстановитьЕмкость(размер_доски_);
	Для индекс = 0 по размер_доски_ - 1 Цикл
		ферзи.Добавить( построитель_модели.СоздатьПеремЦелоеСИменем(домен_переменных, "х" + индекс) );
	КонецЦикла;
	

	построитель_модели.ДобавитьВсеРазличныеПеремЦелое(ферзи);

	диагональ_1 = Новый Массив(размер_доски_);
	диагональ_2 = Новый Массив(размер_доски_);
	Для индекс = 0 по размер_доски_ - 1 Цикл
		перем_выражение		= ферзи[индекс].КакЛинейноеВыражЦелочисленное();
		диагональ_1[индекс] = перем_выражение.СоздатьНовоеДобавив(индекс);
		диагональ_2[индекс] = перем_выражение.СоздатьНовоеОтняв(индекс);		
	КонецЦикла;
	построитель_модели.ДобавитьВсеРазличныеЛинейныеВыражения(диагональ_1);
	построитель_модели.ДобавитьВсеРазличныеЛинейныеВыражения(диагональ_2);
	//
	описание_модели							= построитель_модели.ПолучитьОписаниеМодели();
		
	параметры_модели						= Новый(Типа("ПараметрыМодели"));
	параметры_модели.ПеречислитьВсеРешения	= Истина;
	структура_модели						= Новый Структура("РазмерДоски,Ферзи,КоличествоРешений", размер_доски_, ферзи, 0);
	наблюдатель_за_решением					= Остап.СоздатьНаблюдательЗаРешением(EsbComponent, "НаблюдательЗаРешением", структура_модели);

	модель = Новый(Типа("СатМодель"));
	модель.ДобавитьПараметры(параметры_модели);
	модель.ДобавитьНаблюдателяЗаРешением(наблюдатель_за_решением);
	
	ответ_решателя	= Остап.РешиЗадачуПоМодели(описание_модели, модель);

	сообщить("*----------------------------------------------------------------------");
	сообщить("* ВремяРешения: " + ответ_решателя.ВремяРешения);
	сообщить("*----------------------------------------------------------------------");
КонецПроцедуры 


//
Функция СтартТест() Экспорт
	сообщить("*----------------------------------------------------------------------");
		привет = ЭтотКомпонент().GetHellow();
		ЭтотКомпонент().СкажиПривет( привет );
	сообщить("*----------------------------------------------------------------------");

	
	сообщить("*------------------* Решаем ферзей *-----------------------------------");
	//
	РешиФерзей(4);

	сообщить("*----------------------------------------------------------------------");
		ответ = Вопрос(привет + Символы.ПС + Символы.ПС + "Завершить тест???", РежимДиалогаВопрос.ОКОтмена);
		Если Ответ = КодВозвратаДиалога.ОК Тогда
			ЗавершитьРаботуСистемы(Ложь)
		КонецЕсли;
	возврат Истина;
КонецФункции


