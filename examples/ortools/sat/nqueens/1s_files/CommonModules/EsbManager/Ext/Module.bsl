//EsbManager
//

Функция ЗагрузитьЕсбКомпоненту(файл_компоненты_, имя_объекта_компоненты_, out_EsbComponent__, out_EsbComponentObject__) Экспорт 
	//
	Если НЕ ПодключитьВнешнююКомпонентуЕсб(файл_компоненты_)  Тогда
		возврат  Ложь;
	КонецЕсли; 
	
	out_EsbComponent__ = Новый("AddIn.Esb.EsbComponent");
	если out_EsbComponent__ = Неопределено тогда
		сообщить("НЕ удалось создать компонент AddIn.Esb.EsbComponent!!!");
		возврат Ложь;
	иначе
		сообщить("компонент создан AddIn.Esb.EsbComponent");
	КонецЕсли;
	
	// Теперь собственно ЕСБ. Регистрация есб-объекта компоненты и создание его экземпляра
	сообщить("*----------------------------------------------------------------------");		
	сообщить("* регистрация объекта EsbComponent");		
	//
	Если out_EsbComponent__.RegisterAsSCOM() Тогда
		сообщить("Есб-Компонента успешно зарегистрирован как SCOM модуль.");
	ИначеЕсли out_EsbComponent__.Register() Тогда
		сообщить("Регистрация Есб-Компоненты как SCOM модуля недоступна или неуспешна.");
		сообщить("Объект Есб-Компоненты успешно зарегистрирован принудительно.");
		сообщить("(требуется корректная очистка в Процедуре ПриЗавершенииРаботыСистемы)");
	Иначе
		сообщить("Объект Есб-Компоненты не удалось зарегистрировать. Продолжение невозможно.");
		возврат Ложь;		
	КонецЕсли; 	
	
	out_EsbComponentObject__ = Новый(Типа(имя_объекта_компоненты_));
	сообщить("EsbComponentObject объект успешно создан.");
	
	возврат Истина;
КонецФункции

//
Процедура ВыгрузитьЕсбКомпоненту(in_out_EsbComponent_, in_out_EsbComponentObject_) Экспорт	
	//
	Если in_out_EsbComponentObject_ <> Неопределено  Тогда
		in_out_EsbComponentObject_ = Неопределено;
		Если in_out_EsbComponent_ <> Неопределено  Тогда			
	   		in_out_EsbComponent_.UnRegister();
		КонецЕсли;
	КонецЕсли; 	
	in_out_EsbComponent_ = Неопределено;
КонецПроцедуры
