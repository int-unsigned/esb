//EsbCommon

Функция Типа(ИмяТипа) Экспорт
	возврат Тип(ИмяТипа);
КонецФункции // Типа()


Функция СравнитьВерсию(строка_версия_1_, строка_версия_2_) Экспорт
	вер1 = СтрРазделить(строка_версия_1_, ".");
	вер2 = СтрРазделить(строка_версия_2_, ".");
	Для инд=0 По 3 Цикл
		если Число(вер1[инд]) < Число(вер2[инд]) тогда
			возврат -1;
		иначеесли Число(вер1[инд]) > Число(вер2[инд]) тогда
			возврат 1;
		КонецЕсли;
	КонецЦикла; 
	возврат 0;
КонецФункции // СравнитьВерсию()
//
Функция ВерсияМеньше(строка_версия_1_, строка_версия_2_) Экспорт
	возврат (СравнитьВерсию(строка_версия_1_, строка_версия_2_) < 0);
КонецФункции
Функция ВерсияБольше(строка_версия_1_, строка_версия_2_) Экспорт
	возврат (СравнитьВерсию(строка_версия_1_, строка_версия_2_) > 0);
КонецФункции


Функция ПутьБезПоследнегоРазделителя(путь_) Экспорт
	с_конец = Прав(путь_, 1);
	с_длина = СтрДлина(путь_);
	Пока с_конец = "/" или с_конец = "\" Цикл
		с_длина = с_длина - 1;		
		с_конец = Сред(путь_, с_длина, 1) 
	КонецЦикла; 
	возврат Лев(путь_, с_длина);
КонецФункции

Функция ПутьККонфигурации() Экспорт
	стр_иб = Врег(СтрокаСоединенияИнформационнойБазы());
	поз_1 = СтрНайти(стр_иб, "FILE=");
	поз_е = СтрНайти(стр_иб, """",НаправлениеПоиска.СКонца);
	дир_иб = Сред(стр_иб, поз_1 + 6, поз_е - поз_1 - 6);
	//Если в конце строки стоит '\', то для 1С это нормально, а нам лучше убрать для простоты
	возврат ПутьБезПоследнегоРазделителя(дир_иб);
КонецФункции

Функция ПутьНаУровеньВыше(путь_без_последнего_разделителя_) Экспорт
	с_конец = Прав(путь_без_последнего_разделителя_, 1);
	с_длина = СтрДлина(путь_без_последнего_разделителя_);
	Пока с_длина > 0 И НЕ (с_конец = "/" или с_конец = "\") Цикл
		с_длина = с_длина - 1;		
		с_конец = Сред(путь_без_последнего_разделителя_, с_длина, 1) 
	КонецЦикла; 
	возврат ПутьБезПоследнегоРазделителя(Лев(путь_без_последнего_разделителя_, с_длина));
КонецФункции

Функция ПутьДостроить(путь_, добавить_) Экспорт
	возврат путь_ + "\" + добавить_;
КонецФункции

Функция ЕсбПутьДляОтладкиПостроить(путь_к_проекту_, версия_платформы_, тип_платформы_, использовать_дебаг_длл_) Экспорт
	Перем есб_вер;
	Перем есб_тип;
	Если ВерсияМеньше(версия_платформы_, "8.3.11.0000") тогда
		есб_вер = "v8309";
	ИначеЕсли ВерсияМеньше(версия_платформы_, "8.3.20.0000") тогда
		есб_вер = "v8311";
	ИначеЕсли ВерсияМеньше(версия_платформы_, "8.3.23.0000") тогда
		есб_вер = "v8320";
	иначе
		есб_вер = "v8323";
	КонецЕсли;
	
	Если тип_платформы_ = ТипПлатформы.Windows_x86 тогда
		есб_тип = "Win32";
	ИначеЕсли тип_платформы_ = ТипПлатформы.Windows_x86_64 тогда
		есб_тип = "x64";
	иначе
		возврат Неопределено;
	КонецЕсли;
		
	дир_бин = ПутьДостроить(путь_к_проекту_, "bin");
	дир_вер = ПутьДостроить(дир_бин, есб_вер);
	Если использовать_дебаг_длл_ Тогда
		дир_конф = дир_вер + "Debug";  	//дир_конф = ПутьДостроить(дир_вер, "Debug");
	иначе
		дир_конф = дир_вер + "Release";	//дир_конф = ПутьДостроить(дир_вер, "Release");
	КонецЕсли;
	дир_длл = ПутьДостроить(дир_конф, есб_тип);
	
	возврат дир_длл;
КонецФункции

Функция ЕсбПутьДляОтладки(использовать_дебаг_длл_) Экспорт
	сис_инфо = Новый СистемнаяИнформация;
	сис_инфо_вер = сис_инфо.ВерсияПриложения;	
	сис_инфо_тип = сис_инфо.ТипПлатформы;
	путь_к_конфигу = ПутьККонфигурации();
	путь_к_проекту = ПутьНаУровеньВыше(путь_к_конфигу);	
	
	возврат ЕсбПутьДляОтладкиПостроить(путь_к_проекту, сис_инфо_вер, сис_инфо_тип, использовать_дебаг_длл_);
КонецФункции	


Функция ПодключитьВнешнююКомпонентуНаитивноНеИзолированно(файл_компоненты_, имя_компоненты_) Экспорт
	//	
	сис_инфо = Новый СистемнаяИнформация;
	сис_инфо_версия_платформы = сис_инфо.ВерсияПриложения;	
	резуль = Ложь;
	
	Если СравнитьВерсию(сис_инфо_версия_платформы ,"8.3.21.0000") < 0 Тогда
		резуль = ПодключитьВнешнююКомпоненту(файл_компоненты_, имя_компоненты_, ТипВнешнейКомпоненты.Native);
	Иначе
		// Доступен, начиная с версии 8.3.21
		// Естественно ЕСБ может корректно работать только в режиме ТипПодключенияВнешнейКомпоненты.НеИзолированно
		// Хотя по-умолчанию для полного клиента ТипПодключенияВнешнейКомпоненты.НеИзолированно 
		// но правильно это явно указать.
		// для универсальности приходится через Выполнить :(
		Выполнить("резуль = ПодключитьВнешнююКомпоненту(файл_компоненты_, имя_компоненты_, 
														| ТипВнешнейКомпоненты.Native, 
														| ТипПодключенияВнешнейКомпоненты.НеИзолированно);");
	КонецЕсли;
	возврат резуль;
КонецФункции // ПодключитьКомпонентуЕСБ()

Функция ПодключитьВнешнююКомпонентуЕсб(файл_компоненты_) Экспорт
	//		
	Сообщить("Используется Есб-Компонента: " + файл_компоненты_);
	сообщить("*----------------------------------------------------------------------");	
	
	// типовая загрузка компонены и создание объекта компоненты (не есб-объекта, а обычного объекта компоненты)
	Если ПодключитьВнешнююКомпонентуНаитивноНеИзолированно(файл_компоненты_, "Esb") тогда
		сообщить("Есб-Компонента подключена.");
	иначе
		сообщить("Есб-Компонента НЕ подключена!!!");
		возврат Ложь;
	конецесли;
	Возврат Истина;
КонецФункции

Функция ЕсбСовместимаяПлатформа() Экспорт
	сис_инфо = Новый СистемнаяИнформация;
	сис_инфо_вер = сис_инфо.ВерсияПриложения;	
	Если ВерсияМеньше(сис_инфо_вер ,"8.3.9.1818") ИЛИ ВерсияБольше(сис_инфо_вер, "8.3.23.1688") Тогда
		Сообщить("ЕСБ компонента тестирована с версиями 1С от 8.3.9.1818 до 8.3.23.1688. 
				|Использование ЕСБ в иной конфигурации может привести к непредсказуемым последствиям. 
				|Продолжение работы невозможно. 
				|Если Вы все-же решаете использовать ЕСБ, то отключите эту проверку. 
				|В любом случае Вы действуете на свой страх и риск и разработчик никакой ответственности не несет.");
		возврат Ложь;
	КонецЕсли;
	возврат истина;
КонецФункции // ф()

