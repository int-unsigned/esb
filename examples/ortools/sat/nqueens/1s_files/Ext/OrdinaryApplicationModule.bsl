// Обычное приложение
// Режим использования синхронных вызовов расширений платформы и внешних компонент: ИСПОЛЬЗОВАТЬ
// Режим совместимости - НЕ ИСПОЛЬЗОВАТЬ 


// Нам нужны экспортируемые переменные для работы с компонентой и ее есб-объектом
Перем __EsbComponent__ экспорт;
Перем __EsbComponentObject__ экспорт;
//


Процедура ПриНачалеРаботыСистемы()
	// Если проврка совместимости не нужна - просто замени 1 на 0
	Если 1 И НЕ ЕсбСовместимаяПлатформа() Тогда	
		возврат;
	КонецЕсли;
	
	// Используется только для авто-запуска из конфигуратора, когда ПараметрЗапуска отсутствует
	__ИСПОЛЬЗОВАТЬ_ДЕБАГ_ДЛЛ__ = Истина;
	//__ИСПОЛЬЗОВАТЬ_ДЕБАГ_ДЛЛ__ = Ложь;  // просто "зеремь"/"отремь" чтобы получить нужный режим
	
	параметры_запуска = ПараметрЗапуска;
	путь_к_компоненте = "";
	Если параметры_запуска <> ""  Тогда
		сообщить("ПараметрЗапуска: '" + параметры_запуска + "'");
		Если СтрНачинаетсяС(параметры_запуска, "--esbrun=")  Тогда
			путь_к_компоненте = ПутьДостроить( ПутьНаУровеньВыше(ПутьККонфигурации()), ПутьБезПоследнегоРазделителя(Сред(параметры_запуска, 10)) );
		иначе
			Предупреждение("Неожидаемый ПараметрЗапуска:" +	Символы.ПС + 
								параметры_запуска + Символы.ПС + Символы.ПС + 
								"Ожидается '--esbrun=<путь_к_есб_компоненте>'. Продолжение работы невозможно");
			ЗавершитьРаботуСистемы(ложь);								
		КонецЕсли;     
	иначе
		сообщить("ПараметрЗапуска отсутствует. Загрузка Есб-Компонента для отладки по-умолчанию.");
		путь_к_компоненте = ЕсбПутьДляОтладки(__ИСПОЛЬЗОВАТЬ_ДЕБАГ_ДЛЛ__);
	КонецЕсли;     
	
	
	Если EsbComponent.Загрузить(путь_к_компоненте) тогда
		EsbComponent.СтартТест();
	КонецЕсли;	
КонецПроцедуры


Процедура ПриЗавершенииРаботыСистемы ()
	//!!! ОЧЕНЬ ВАЖНО, ЕСЛИ ЗАГРУЖАЕМСЯ НЕ КАК SCOM-Модуль !!!
	EsbComponent.Выгрузить();
КонецПроцедуры

