<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="16.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
<!--
	Импортируется из
	"c:\Program Files\Microsoft Visual Studio\2019\Enterprise\MSBuild\Current\Microsoft.Common.props"
	Которое импортируется в самом-самом начале

	Здесь мы задаем параметры по-умолчанию для всего проекта (безусловно по-конфигурациям)
	Эти параметры имеют суффикс _AUTO. На странице свойств они показываются в ReadOnly режиме.
	Конкретные используемые параметры по-умолчанию ссылаются на свои _AUTO значения,
	но их можно переопределить для конкретной конфигурации проекта на странице свойств.
	(переопределенный значения записываются в .vcxproj.user файл)
	ПС. Не исключено, что все это нужно делать в esb_template.user.props для проекта
		Cейчас пустая. Она подключается после directory.build.props и после всех Microsoft.Cpp.props
		(т.е когда многие свойства уже определены)

	.vcxproj.user импортируется поздно из 
	Microsoft.Common.targets -
		...\Microsoft Visual Studio\...\MSBuild\Current\Bin\Microsoft.Common.CurrentVersion.targets
		Import Project="$(MSBuildProjectFullPath).user" Condition="Exists('$(MSBuildProjectFullPath).user')"
-->

	<PropertyGroup Label="EsbSettings">
		<ESB_VER_AUTO>$(Configuration.Substring(1,4))</ESB_VER_AUTO>
    	<ESB_VER Condition="'$(ESB_VER )' == ''">$(ESB_VER_AUTO)</ESB_VER>

		<ESB_PATH_AUTO>$([MSBuild]::GetRegistryValue(`HKEY_CURRENT_USER\Software\IntUnsigned\Esb`, `Location`))</ESB_PATH_AUTO>
		<ESB_PATH Condition="'$(ESB_PATH)' == ''">$(ESB_PATH_AUTO)</ESB_PATH>

		<!--	stdcpp20, stdcpplatest - это имена EnumValue со страницы MC cl.xml	-->
		<ESB_CPP_LANG>stdcpp20</ESB_CPP_LANG>

		<ESB_PATH_INCLUDE>$(ESB_PATH)\include</ESB_PATH_INCLUDE>

		<!--	EsbUseLangAll, EsbUseLangOnlyEn, EsbUseLangOnlyRu, EsbUseLangNone (не определять макросы)	-->
		<ESB_USE_LANG>EsbUseLangAll</ESB_USE_LANG>
	</PropertyGroup>


	<PropertyGroup>
		<ConfigurationType>DynamicLibrary</ConfigurationType>
		<PlatformToolset>v142</PlatformToolset>
		<CharacterSet>Unicode</CharacterSet>
<!-- 
	и $(ProjectDir) и $(SolutionDir) (на основании $(ProjectDir)) определяются в Microsoft.Cpp.Default.props
	на основании $(MSBuildProjectDirectory)
	Поэтому используем $(MSBuildProjectDirectory) напрямую
	(ПС. ...Do not include the final backslash on this property. https://learn.microsoft.com/en-us/visualstudio/msbuild/msbuild-reserved-and-well-known-properties?view=vs-2022)
	$(PlatformShortName) определяется в \Platforms\<Name>\Platform.Default.props, который грузится из Mirosoft.Cpp.Default.props
	т.е. ПОСЛЕ того как загружается directory.build.props и соответственно здесь оно пустое. Поэтому используем просто $(Platform)
-->
		<OutDir>$(MSBuildProjectDirectory)\bin\$(Configuration)\$(Platform)\</OutDir>
		<IntDir>bin\$(Configuration)\$(Platform)\</IntDir>
	</PropertyGroup>


<!--
	К сожалению конструкцию Choose можно использовать только на уровне проекта, а в ней можно использовать только
	PropertyGroup и ItemGroup (ItemDefinitionGroup нельзя)
	Народ тоже недоумевает: https://github.com/dotnet/msbuild/issues/5436
	Но в документации именно так:	https://learn.microsoft.com/ru-ru/visualstudio/msbuild/msbuild-conditional-constructs?view=vs-2022
	И в коде именно так:	https://github.com/dotnet/msbuild/blob/6033e4c95bcd9fa31ebe9b52462c15521cda8f62/src/Build/Evaluation/ProjectParser.cs#L848-L872
	В таком виде она малополезна, но пусть будет здесь для памяти
	TODO	ПС. В текущей ветке на гитхабе это исправлено:
			https://github.com/dotnet/msbuild/blob/main/src/Build/Evaluation/ProjectParser.cs#L846
	<Choose>
		<When Condition=" '$(Configuration)'=='Debug' ">
		</When>
		<When Condition=" '$(Configuration)'=='retail' ">
		</When>
		<Otherwise>
		</Otherwise>
	</Choose>
-->


<!--
	Дефайны (PreprocessorDefinitions) лучше прямо постепенно добавлять непосредственно в PreprocessorDefinitions
	а не использовать Property и(или) Item, т.к. тогда они прямо текстом показываются в окошке "Вычисленные значения"
	(а если свойством, то показывается именно свойство н.р. ESB_VER=$(ESB_VER), а чему оно равно не видно)
-->
	<ItemDefinitionGroup>
		<ClCompile>
			<LanguageStandard Condition="'$(ESB_CPP_LANG)' == 'stdcpp20'">stdcpp20</LanguageStandard>
			<LanguageStandard Condition="'$(ESB_CPP_LANG)' == 'stdcpplatest'">stdcpplatest</LanguageStandard>
			<LanguageStandard Condition="'%(ClCompile.LanguageStandard)' == ''">stdcpp20</LanguageStandard>
			<ConformanceMode>true</ConformanceMode>
			<UseStandardPreprocessor>true</UseStandardPreprocessor>
			<SDLCheck>true</SDLCheck>

			<AdditionalIncludeDirectories>$(ESB_PATH_INCLUDE);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
			<PrecompiledHeader>NotUsing</PrecompiledHeader>
			<PreprocessorDefinitions>WIN32;_WINDOWS;_USRDLL;ESB_VER=$(ESB_VER);%(PreprocessorDefinitions)</PreprocessorDefinitions>
			<WarningLevel>Level3</WarningLevel>
		</ClCompile>
		<Link>
			<SubSystem>Windows</SubSystem>
			<EnableUAC>false</EnableUAC>
			<AdditionalOptions>/EXPORT:GetClassObject /EXPORT:DestroyObject /EXPORT:GetClassNames /EXPORT:SetPlatformCapabilities %(AdditionalOptions)</AdditionalOptions>
		</Link>
	</ItemDefinitionGroup>


	<!-- ПС. ЕСЛИ этот ИтемДеф перенести в таргетс, то доп-каталоги включения исчезают :( -->
	<ItemDefinitionGroup Condition="'$(UseDebugLibraries)' == 'true'">
		<ClCompile>
			<RuntimeLibrary>MultiThreadedDebug</RuntimeLibrary>
			<PreprocessorDefinitions>_DEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
		</ClCompile>
	</ItemDefinitionGroup>
	<ItemDefinitionGroup Condition="'$(UseDebugLibraries)' != 'true'">
		<ClCompile>
			<RuntimeLibrary>MultiThreaded</RuntimeLibrary>
			<PreprocessorDefinitions >NDEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
		</ClCompile>
		<Link>
			<EnableCOMDATFolding>true</EnableCOMDATFolding>
			<OptimizeReferences>true</OptimizeReferences>
		</Link>	
	</ItemDefinitionGroup>
	

	<ItemDefinitionGroup>
		<ClCompile>
			<PreprocessorDefinitions 
				Condition="'$(ESB_USE_LANG)'=='EsbUseLangOnlyEn'">%(PreprocessorDefinitions);ESB_USE_ENGLISH=1;ESB_USE_RUSSIAN=0</PreprocessorDefinitions>
			<PreprocessorDefinitions 
				Condition="'$(ESB_USE_LANG)'=='EsbUseLangOnlyRu'">%(PreprocessorDefinitions);ESB_USE_ENGLISH=0;ESB_USE_RUSSIAN=1</PreprocessorDefinitions>
			<PreprocessorDefinitions 
				Condition="'$(ESB_USE_LANG)'=='EsbUseLangAll'"   >%(PreprocessorDefinitions);ESB_USE_ENGLISH=1;ESB_USE_RUSSIAN=1</PreprocessorDefinitions>
			<!-- В иных случаях (EsbUseLangNone) мы макросы не определяем -->
		</ClCompile>
	</ItemDefinitionGroup>


<!--
	TODO	Нюанс сборки esbhlp.lib в для дебаг-режима. Нужно попробовать разрулить это при сборке самой esbhlp
-->
	<ItemDefinitionGroup Condition="'$(UseDebugLibraries)' == 'true'">
		<Link>
			<IgnoreSpecificDefaultLibraries>libcpmtd0.lib;%(IgnoreSpecificDefaultLibraries)</IgnoreSpecificDefaultLibraries>
		</Link>
	</ItemDefinitionGroup>



<!--	Вообще-то у МС все страницы свойств загружаются из Microsoft.Cpp.targets в самом конце файла проекта
		(возможно имеется в виду, что к этому моменту все уже конкретно определилось)
		перед этим (где нибудь, можно и здесь) задать опции не делать этого и сформировать весь свой набор страниц вручную
  <PropertyGroup>
    <UseDefaultProjectTools>false</UseDefaultProjectTools>
    <UseDefaultPropertyPageSchemas>false</UseDefaultPropertyPageSchemas>
    <UseDefaultGeneralPropertyPageSchema>false</UseDefaultGeneralPropertyPageSchema>
    <UseDefaultDebuggersPropertyPageSchemas>false</UseDefaultDebuggersPropertyPageSchemas>
	<ImportDirectoryBuildTargets>false</ImportDirectoryBuildTargets>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />

  <ItemGroup>
    <PropertyPageSchema Include="$(CurrentVCTargetsPath)$(LangID)\ProjectItemsSchema.xml" />
    <PropertyPageSchema Include="$(CurrentVCTargetsPath)$(LangID)\general.xml">
      <Context>Project</Context>
    </PropertyPageSchema>
  </ItemGroup>
-->

	
<!--
	ESB_1C_PATH Пишется в ProjectFile т.к. шаблон студии .vcxproj.user не копирует и соответственно настройку на конфигурации в нем провести невозможно
	А свойства для отладчика пишутся именно в .vcxproj.user, а он после создания мастером пуст
	поэтому мы здесь зададим неоходимые нам свойства по-умолчанию и без разреза по конфигурациям
	Поскольку для невозможной к отладке на данной машине конфикурации нельзя как-то по-умному отключить команду Отладка-F5,
	а некрасивое окно смотреть не хочется, то мы LocalDebuggerCommand зададим на _1s_run.cmd безусловно,
	но параметрами батнику передадим, что отладка невозможна - он расскажет
-->
	<PropertyGroup>
		<LocalDebuggerCommand>_1s_run.cmd</LocalDebuggerCommand>
		<LocalDebuggerCommandArguments  Condition="'$(ESB_1C_PATH)' == ''">$(Configuration)_$(Platform)</LocalDebuggerCommandArguments>
		<LocalDebuggerCommandArguments  Condition="'$(ESB_1C_PATH)' != ''">$(IntDir) $(ESB_1C_PATH)</LocalDebuggerCommandArguments>
		<DebuggerFlavor>WindowsLocalDebugger</DebuggerFlavor>
	</PropertyGroup>

	
	<ItemGroup>
    <PropertyPageSchema Include="_esb_props_ui.xml">
      <Context>Project</Context>
    </PropertyPageSchema>
  </ItemGroup>

</Project>
